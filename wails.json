{
  "name": "go-music-tools",
  "outputfilename": "music-tools",
  "frontend": {
    "dir": "./frontend",
    "install": "pnpm --dir frontend install --frozen-lockfile",
    "build": "pnpm --dir frontend run build",
    "dev": "pnpm --dir frontend run dev",
    "devServerUrl": "http://localhost:5173"
  },
  "info": {
    "productName": "Music Tools",
    "productVersion": "1.0.0",
    "description": "音乐下载与整理工作台",
    "comments": "Go + Wails + Vue + TypeScript"
  }
}
